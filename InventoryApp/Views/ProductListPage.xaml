<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:InventoryApp.ViewModels"
             xmlns:models="clr-namespace:InventoryApp.Models"
             xmlns:converters="clr-namespace:InventoryApp.Converters"
             x:Class="InventoryApp.Views.ProductListPage"
             Title="Termékek Leltára"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:QuantityToColorConverter x:Key="QuantityToColorConverter" />
            <converters:QuantityToDecreaseVisibleConverter x:Key="QuantityToDecreaseVisibleConverter" />
            <converters:QuantityToDeleteVisibleConverter x:Key="QuantityToDeleteVisibleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="10">

        <SearchBar Grid.Row="0"
                   Placeholder="Keresés név vagy vonalkód alapján..."
                   Text="{Binding SearchText}"
                   Margin="0,0,0,10" />

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadProductsCommand}"
                     IsRefreshing="{Binding IsRefreshing}">

            <CollectionView ItemsSource="{Binding Products}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <SwipeView>
                            <VerticalStackLayout Padding="10" BackgroundColor="Transparent">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=GoToDetailCommand}"
                                                          CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Label Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" />

                                <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                    <Label Text="{Binding Barcode, StringFormat='Vonalkód: {0}'}" 
                                           FontSize="14" 
                                           TextColor="Gray" />

                                    <Label Text="{Binding Price, StringFormat='Ár: {0:C}'}" 
                                           FontSize="14" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10" Margin="0,5,0,0" VerticalOptions="Center">
                                    <Label Text="{Binding Quantity, StringFormat='Készlet: {0}'}" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="{Binding Quantity, Converter={StaticResource QuantityToColorConverter}}" />

                                    <Button Text="+"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            CornerRadius="18"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=IncreaseQuantityCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Törlés"
                                            IsVisible="{Binding Quantity, Converter={StaticResource QuantityToDeleteVisibleConverter}}"
                                            WidthRequest="70"
                                            HeightRequest="36"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=DecreaseOrDeleteQuantityCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="-"
                                            IsVisible="{Binding Quantity, Converter={StaticResource QuantityToDecreaseVisibleConverter}}"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            CornerRadius="18"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=DecreaseOrDeleteQuantityCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                                <BoxView HeightRequest="1" Color="LightGray" Margin="0,10,0,0" />
                            </VerticalStackLayout>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="+"
                FontSize="24"
                CornerRadius="30"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Command="{Binding GoToAddProductCommand}" />
    </Grid>
</ContentPage>
    