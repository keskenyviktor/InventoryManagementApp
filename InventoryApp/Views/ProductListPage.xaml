<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:InventoryApp.ViewModels"
             xmlns:models="clr-namespace:InventoryApp.Models"
             xmlns:converters="clr-namespace:InventoryApp.Converters"
             x:Class="InventoryApp.Views.ProductListPage"
             Title="Terméklista"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:QuantityToColorConverter x:Key="QuantityToColorConverter" />
            <converters:QuantityToDecreaseVisibleConverter x:Key="QuantityToDecreaseVisibleConverter" />
            <converters:QuantityToDeleteVisibleConverter x:Key="QuantityToDeleteVisibleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Padding="12" RowSpacing="10">

        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#F3F6FB, Dark=#1E1E1E}"
                Padding="12,10"
                StrokeShape="RoundRectangle 18">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Leltár" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding TotalItems, StringFormat='{0} termék'}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>

                <SearchBar Grid.Column="1"
                           Placeholder="Keresés..."
                           Text="{Binding SearchText}"
                           WidthRequest="220"
                           BackgroundColor="White"
                           PlaceholderColor="Gray" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadProductsCommand}"
                     IsRefreshing="{Binding IsRefreshing}">

            <CollectionView ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            Margin="0,0,0,8">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Nincsenek termékek" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center" />
                        <Label Text="Adjon hozzá új elemeket a + gombbal." TextColor="Gray" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <SwipeView>
                            <Border Margin="0,0,0,8"
                                    Padding="14"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#DDE6F3, Dark=#2C2C2C}"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1A}"
                                    StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=GoToDetailCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                        <Label Text="{Binding Barcode, StringFormat='Vonalkód: {0}'}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            Padding="10,6"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding Quantity, Converter={StaticResource QuantityToColorConverter}}"
                                            StrokeShape="RoundRectangle 12">
                                        <Label Text="{Binding Quantity, StringFormat='{0} db'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="1"
                                                           Grid.Column="0"
                                                           Spacing="10"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding Price, StringFormat='Ár: {0:C}'}" FontSize="13" />
                                        <Label Text="•" TextColor="Gray" />
                                        <Label Text="{Binding Quantity, StringFormat='Készlet: {0}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Quantity, Converter={StaticResource QuantityToColorConverter}}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Row="1"
                                                           Grid.Column="1"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Button Text="+"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                CornerRadius="17"
                                                FontSize="18"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=IncreaseQuantityCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Text="Törlés"
                                                IsVisible="{Binding Quantity, Converter={StaticResource QuantityToDeleteVisibleConverter}}"
                                                WidthRequest="72"
                                                HeightRequest="34"
                                                FontSize="11"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=DecreaseOrDeleteQuantityCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Text="-"
                                                IsVisible="{Binding Quantity, Converter={StaticResource QuantityToDecreaseVisibleConverter}}"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                CornerRadius="17"
                                                FontSize="18"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductListViewModel}}, Path=DecreaseOrDeleteQuantityCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#F3F6FB, Dark=#1E1E1E}"
                Padding="10,8"
                StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Button Text="Előző"
                        WidthRequest="90"
                        IsEnabled="{Binding HasPreviousPage}"
                        Command="{Binding PreviousPageCommand}" />

                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
                    <Label Text="Oldal" VerticalTextAlignment="Center" />
                    <Label Text="{Binding CurrentPage}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    <Label Text="/" VerticalTextAlignment="Center" />
                    <Label Text="{Binding TotalPages}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Picker Grid.Column="2"
                        Title="Oldalanként"
                        ItemsSource="{Binding PageSizes}"
                        SelectedItem="{Binding PageSize}"
                        WidthRequest="110" />

                <Button Grid.Column="3"
                        Text="Következő"
                        WidthRequest="95"
                        IsEnabled="{Binding HasNextPage}"
                        Command="{Binding NextPageCommand}" />
            </Grid>
        </Border>

        <Button Grid.Row="1"
                Text="+"
                FontSize="24"
                CornerRadius="30"
                WidthRequest="62"
                HeightRequest="62"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                BackgroundColor="{AppThemeBinding Light=#2F6BFF, Dark=#7AA2FF}"
                Command="{Binding GoToAddProductCommand}" />
    </Grid>
</ContentPage>
    