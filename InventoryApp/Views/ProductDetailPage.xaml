<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.ProductDetailPage"
             Title="Termék részletei">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Entry x:Name="NameEntry"
                   Placeholder="Termék neve" />

            <Entry x:Name="BarcodeEntry"
                   Placeholder="Vonalkód" />
            <Button Text="Beolvasás kamerával"
                    Clicked="ScanBarcodeButton_Clicked"
                    HorizontalOptions="Start" />

            <Entry x:Name="PriceEntry"
                   Keyboard="Numeric"
                   Placeholder="Ár" />

            <Entry x:Name="QuantityEntry"
                   Keyboard="Numeric"
                   Placeholder="Készlet" />

            <Button Text="Mentés"
                    Clicked="SaveButton_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
